# SumoPod API key for the sandbox account.
# Leave empty to use local payment simulation.
SUMOPOD_API_KEY=

# Keep demo and sandbox enabled for workshops.
MODE_DEMO=1
SUMOPOD_SANDBOX=1

# Optional Arduino serial settings. Change COM3 to the port shown on your PC.
VENDING_SERIAL_PORT=COM3
VENDING_SERIAL_BAUD=9600
